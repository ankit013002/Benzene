# Node agent. Copy to .env and fill in.

# Reached through the gateway, not the control plane directly.
BENZENE_CONTROL_PLANE_URL=http://localhost:8080

# How much disk this machine contributes. 50 GB shown.
BENZENE_ALLOCATED_BYTES=53687091200

# Identity and object store live here. The Ed25519 private key in
# identity.json never leaves this machine.
# BENZENE_DATA_DIR=~/.benzene

# BENZENE_AGENT_PORT=7070
# BENZENE_DEVICE_NAME=

# Where peers should reach this device. Defaults to the first non-internal
# IPv4 address, which is what makes browser-to-device transfer work on a LAN.
# BENZENE_ADVERTISED_URL=http://192.168.1.20:7070

# BENZENE_HEARTBEAT_MS=30000
# BENZENE_REBALANCE_MS=60000
