# Frontend. Copy to .env.local and fill in.

# Server-side and browser-side origins for the gateway.
GATEWAY_ORIGIN=http://localhost:8080
NEXT_PUBLIC_GATEWAY_ORIGIN=http://localhost:8080

APP_BASE_URL=http://localhost:3000

# Must be byte-identical across the frontend, gateway and auth service, and at
# least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Optional, explicit publisher values for HTTPS mobile app-link verification.
# The well-known handlers return 404 until each platform's values are valid.
APPLE_APP_LINK_TEAM_ID=
APPLE_APP_LINK_BUNDLE_ID=
ANDROID_APP_LINK_APPLICATION_ID=
# Comma-separated SHA-256 signing certificate fingerprints (colon-delimited).
ANDROID_APP_LINK_SHA256_CERT_FINGERPRINTS=
