# Control plane. Copy to .env and fill in.

PORT=5000

# Control-plane graph: vaults, devices, allocations, replicas.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/benzene

# Legacy file metadata. Still required to boot until it migrates to Postgres.
MONGOOSE_URI=mongodb://localhost:27017/benzene

# Signs transfer grants, which authorise a browser to PUT one object to one
# device. Required for uploads; generate with:
#   node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'der'}).toString('base64'))"
TRANSFER_SIGNING_KEY=

# "local" writes to this server's disk and needs no AWS credentials.
# "s3" additionally requires S3_BUCKET and AWS_REGION.
STORAGE_DRIVER=local
# S3_BUCKET=
# AWS_REGION=

# Optional tuning.
# MAX_UPLOAD_BYTES=5368709120
# PRESIGN_TTL_SECONDS=900
# DEVICE_OFFLINE_AFTER_SECONDS=120
# ENROLLMENT_CODE_TTL_SECONDS=600
# ENROLLMENT_RATE_LIMIT_MAX=10
# ENROLLMENT_RATE_LIMIT_WINDOW_SECONDS=60
# ENROLLMENT_PAIRING_RATE_LIMIT_MAX=10
# ENROLLMENT_PAIRING_RATE_LIMIT_WINDOW_SECONDS=60
# TRANSFER_GRANT_TTL_SECONDS=300

# Only used by the test suite. Point at a Postgres *server*; each test file
# creates and drops its own throwaway database.
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
