{
  "name": "benzene-desktop",
  "version": "0.1.0",
  "description": "Benzene desktop client and independent local node agent",
  "author": "Benzene",
  "private": true,
  "main": "built/main.js",
  "scripts": {
    "build:agent": "node scripts/build-agent.mjs",
    "build:renderer": "esbuild src/setup.ts --bundle --platform=browser --format=iife --outfile=built/setup.js",
    "build": "npm run build:agent && tsc -p tsconfig.json && npm run build:renderer && npm run build:release-config",
    "build:release-config": "node scripts/write-release-config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/*.test.ts scripts/*.test.mjs",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "smoke:dist:win": "npm run build && electron-builder --win nsis --publish never",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:prepare-macos-signing": "node scripts/prepare-macos-signing.mjs",
    "release:dist:mac": "npm run build && electron-builder --mac dmg --publish never",
    "release:dist:win": "npm run build && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "dotenv": "17.4.2",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "express": "5.2.1",
    "esbuild": "^0.27.0",
    "helmet": "8.3.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "ws": "8.22.0",
    "zod": "4.6.0"
  },
  "build": {
    "appId": "com.benzene.desktop",
    "productName": "Benzene",
    "directories": {
      "output": "release"
    },
    "files": [
      "built/**/*",
      "src/setup.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "built/node-agent.cjs",
        "to": "node-agent.cjs"
      }
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
