# Public API origin. Use the HTTPS gateway origin for all non-local builds.
EXPO_PUBLIC_GATEWAY_ORIGIN=https://gateway.example.invalid

# Store identifiers are project-owned values. Replace the explicit example
# before production signing; these are not store credentials or signing keys.
IOS_BUNDLE_IDENTIFIER=com.example.benzene
ANDROID_APPLICATION_ID=com.example.benzene

# Publish a real privacy policy before store review.
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://example.invalid/privacy
EXPO_PUBLIC_TERMS_OF_SERVICE_URL=https://example.invalid/terms
EXPO_PUBLIC_SUPPORT_URL=https://example.invalid/support
