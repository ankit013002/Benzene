# Auth service. Copy to .env and fill in.

PORT=4000
APP_ORIGIN=http://localhost:3000

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/benzene_auth
# Optional PEM CA chain for a private production PostgreSQL certificate.
# Production connections always validate the server certificate.
# DATABASE_SSL_CA=

# Must match the frontend and gateway exactly; >=32 chars. The service refuses
# to start otherwise, deliberately — a weak shared key undermines every
# downstream identity claim.
AUTH_SECRET=

# Optional account-deletion cleanup worker. The profile URL, secret, and
# interval are required together. The control-plane URL and secret are an
# optional pair; without them the worker safely blocks at stored_objects.
# When enabled, the same private control-plane adapter also runs device_data
# after stored_objects has completed its durable replica acknowledgements.
# Internal service secrets must match their private endpoints. Production URLs
# must use HTTPS.
# ACCOUNT_DELETION_USER_SERVICE_URL=http://localhost:8082/internal/account-deletion
# ACCOUNT_DELETION_USER_SERVICE_SECRET=
# ACCOUNT_DELETION_CONTROL_PLANE_URL=http://localhost:5000/internal/account-deletion
# ACCOUNT_DELETION_CONTROL_PLANE_SECRET=
# ACCOUNT_DELETION_WORKER_INTERVAL_SECONDS=30

# Email verification and password reset. Without these the service still runs;
# those flows just cannot deliver.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Benzene <no-reply@benzene.local>"
